{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SysTorch",
  "mainBinaryName": "systorch",
  "version": "0.12.0",
  "identifier": "io.github.arcj137442.jevswitch",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build --prefix ui",
    "frontendDist": "./shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SysTorch",
        "url": "waiting.html",
        "width": 900,
        "height": 560,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/systorch-daemon"],
    "resources": {
      "../ui/dist": "ui/dist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
